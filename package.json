{
    "name": "loft",
    "productName": "Loft",
    "version": "0.1.0",
    "private": true,
    "description": "Loft: a Telegram media downloader",
    "author": "paulpeng-popo",
    "license": "MIT",
    "repository": "github:paulpeng-popo/Loft",
    "main": "electron/main.js",
    "scripts": {
        "start": "node --no-warnings=ExperimentalWarning src/server.js",
        "app": "electron .",
        "runtime": "electron-builder --config build/launcher.json --win dir",
        "dist": "electron-builder",
        "dist:win": "electron-builder --win",
        "dist:mac": "electron-builder --mac",
        "dist:linux": "electron-builder --linux"
    },
    "engines": {
        "node": ">=22.13"
    },
    "dependencies": {
        "express": "4.21.2",
        "jpeg-js": "0.4.4",
        "node-cron": "3.0.3",
        "telegram": "2.26.22"
    },
    "devDependencies": {
        "electron": "44.5.1",
        "electron-builder": "26.15.3"
    },
    "build": {
        "appId": "io.github.paulpeng-popo.loft",
        "productName": "Loft",
        "artifactName": "Loft-${version}-${os}-${arch}.${ext}",
        "directories": {
            "output": "dist",
            "buildResources": "build"
        },
        "files": [
            "electron/**",
            "!electron/launcher.js",
            "src/**",
            "public/**",
            "build/icon.png",
            "package.json"
        ],
        "asarUnpack": [
            "public/**"
        ],
        "npmRebuild": false,
        "win": {
            "target": [
                {
                    "target": "zip",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "build/icon.png"
        },
        "mac": {
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "arm64",
                        "x64"
                    ]
                }
            ],
            "category": "public.app-category.utilities",
            "icon": "build/icon.png"
        },
        "linux": {
            "target": [
                {
                    "target": "AppImage",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "tar.gz",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "category": "Network",
            "icon": "build/icon.png"
        }
    }
}
